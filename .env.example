# AI-3016 local environment example
# `azd up` generates .env automatically. Use this file only for manual setup.
# Configure provisioning with `azd env set`; this root file is runtime configuration.
# Never place real credentials in this file.

# Microsoft Foundry resource and model deployment
ENDPOINT_URL=https://<foundry-resource>.cognitiveservices.azure.com/
DEPLOYMENT_NAME=gpt-4o
AZURE_AI_FOUNDRY_API_KEY=

# Microsoft Foundry project (used by 3b, 3c, 8, and readiness)
AZURE_AI_PROJECT_NAME=ai3016-project
AZURE_AI_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/ai3016-project
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_AI_AUTH_MODE=entra

# Azure OpenAI-compatible endpoint on the same Foundry resource
AZURE_OPENAI_ENDPOINT=https://<foundry-resource>.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-05-01-preview
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT_NAME=text-embedding-ada-002

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_ADMIN_KEY=<search-admin-key>
AZURE_SEARCH_INDEX=rag-bank-documents

# Demo 7: Azure AI Language PII redaction; use synthetic customer text.
# Endpoint is optional for a unified Foundry resource; Entra ID is used when key is empty.
AZURE_LANGUAGE_ENDPOINT=https://<foundry-resource>.cognitiveservices.azure.com/
AZURE_LANGUAGE_KEY=

# Demo 7: Voice Live (also checked by readiness when Language/Voice is selected)
# Voice Live receives original microphone audio; text redaction happens afterward.
# Endpoint is optional for a unified Foundry resource; Entra ID is used when key is empty.
AZURE_VOICELIVE_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/
AZURE_VOICELIVE_API_KEY=
AZURE_VOICELIVE_MODEL=gpt-realtime
AZURE_VOICELIVE_VOICE=en-US-Ava:DragonHDLatestNeural
VOICE_LIVE_NOISE_GATE_THRESHOLD=500

# Storage
AZURE_STORAGE_ACCOUNT_NAME=<storage-account>
AZURE_STORAGE_CONTAINER_NAME=rag-sources
AZURE_STORAGE_ENDPOINT=https://<storage-account>.blob.core.windows.net/
AZURE_STORAGE_CONNECTION_STRING=

# Azure Key Vault
AZURE_KEY_VAULT_NAME=<key-vault>
AZURE_KEY_VAULT_URI=https://<key-vault>.vault.azure.net/

# General Azure context
AZURE_ENV_NAME=<environment-name>
AZURE_RESOURCE_GROUP=<resource-group>
AZURE_LOCATION=swedencentral
AZURE_TENANT_ID=<tenant-id>
AZURE_DEMO_INCLUDE_LANGUAGE_VOICE=false
# Explicit opt-in only: local sources/.env when tenant policy disables Storage/Key Vault public access.
AZURE_DEMO_ALLOW_POLICY_FALLBACK=false
# Optional VNet-integrated manual job verifies protected Blob Storage and Key Vault from Azure.
AZURE_DEMO_PRIVATE_SETUP=false
AZURE_DEMO_PRIVATE_SETUP_JOB_ID=
AZURE_DEMO_PRIVATE_SETUP_EXECUTION_ID=

# Optional fine-tuned model comparison
FINE_TUNED_DEPLOYMENT_NAME=
